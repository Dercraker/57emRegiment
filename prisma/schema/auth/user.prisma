model User {
  id            String    @id  @default(uuid())
  email         String    @unique
  emailVerified Boolean
  name          String
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  disabledAt    DateTime? @db.Timestamptz(3)

  sessions      Session[]
  accounts      Account[]

  inventories   Inventory[]
  transactions  Transaction[]

	@@map("user")

  @@schema("auth")
}
