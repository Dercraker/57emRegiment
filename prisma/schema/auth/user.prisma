model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String
	image String?

  sessions     Session[]
  accounts     Account[]

  inventories  Inventory[]
  transactions Transaction[]

  createdAt DateTime   @default(now())
	updatedAt DateTime   @db.Timestamptz(3)
  disabledAt DateTime? @db.Timestamptz(3)
	@@map("user")

  @@schema("auth")
}
