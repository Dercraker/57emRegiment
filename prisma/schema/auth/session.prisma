model Session {
	id String @id
	user User @relation(fields: [userId], references: [id])
	userId String
	token String @unique
	expiresAt DateTime @db.Timestamptz(3)
	roles     String[]
	ipAddress String?
	userAgent String?
	createdAt DateTime @db.Timestamptz(3)
	updatedAt DateTime @db.Timestamptz(3)
	@@map("session")

	@@schema("auth")
}