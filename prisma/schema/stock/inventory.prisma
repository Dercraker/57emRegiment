model Inventory {
  id         String  @id @default(uuid())
  name       String
  accessCode String?

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  stocks           Stock[]
  fromTransactions Transaction[] @relation("FromInventory")
  toTransactions   Transaction[] @relation("ToInventory")

  createdAt DateTime @default(now())
  updatedAt DateTime?

  @@schema("stock")
}
